{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "api/schemas/_common/trust-carrier.json",
  "title": "TrustCarrier",
  "description": "Algorithm-agile structural trust/integrity carrier (F13-TRUST-001; design section 7.9; AD-022). Fields are structural identifiers and opaque trust-state tokens only. No canonicalization, digest computation, signing, or cryptographic verification is selected or executed (ADR-F13-002). RID-08: a present-but-structurally-empty optional carrier is invalid; absence is valid.",
  "type": "object",
  "properties": {
    "state": {
      "type": "string",
      "minLength": 1,
      "maxLength": 253,
      "description": "Structural trust-state token; required when the carrier is present.",
      "x-sovrunn-field-policy": {
        "classification": "Internal",
        "authorizedWriter": "system",
        "authorizedReaders": [
          "governance",
          "internal",
          "operator"
        ],
        "mutability": "immutable",
        "retention": "archival",
        "redaction": "none",
        "residency": "any",
        "auditRequired": true
      }
    },
    "canonicalizationMethod": {
      "type": "string",
      "minLength": 1,
      "maxLength": 253,
      "description": "Optional structural canonicalization-method identifier; no execution.",
      "x-sovrunn-field-policy": {
        "classification": "Internal",
        "authorizedWriter": "system",
        "authorizedReaders": [
          "governance",
          "internal",
          "operator"
        ],
        "mutability": "immutable",
        "retention": "archival",
        "redaction": "none",
        "residency": "any",
        "auditRequired": true
      }
    },
    "digestAlgorithm": {
      "type": "string",
      "minLength": 1,
      "maxLength": 253,
      "description": "Optional structural digest-algorithm identifier; no computation.",
      "x-sovrunn-field-policy": {
        "classification": "Internal",
        "authorizedWriter": "system",
        "authorizedReaders": [
          "governance",
          "internal",
          "operator"
        ],
        "mutability": "immutable",
        "retention": "archival",
        "redaction": "none",
        "residency": "any",
        "auditRequired": true
      }
    },
    "coveredFields": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "description": "Optional covered-field descriptor; structural only.",
      "x-sovrunn-field-policy": {
        "classification": "Internal",
        "authorizedWriter": "system",
        "authorizedReaders": [
          "governance",
          "internal",
          "operator"
        ],
        "mutability": "immutable",
        "retention": "archival",
        "redaction": "none",
        "residency": "any",
        "auditRequired": true
      }
    },
    "signatureAlgorithm": {
      "type": "string",
      "minLength": 1,
      "maxLength": 253,
      "description": "Optional structural signature-algorithm identifier; no signing or verification.",
      "x-sovrunn-field-policy": {
        "classification": "Internal",
        "authorizedWriter": "system",
        "authorizedReaders": [
          "governance",
          "internal",
          "operator"
        ],
        "mutability": "immutable",
        "retention": "archival",
        "redaction": "none",
        "residency": "any",
        "auditRequired": true
      }
    }
  },
  "required": [
    "state"
  ],
  "additionalProperties": false
}
