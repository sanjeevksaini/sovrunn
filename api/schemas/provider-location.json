{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "api/schemas/provider-location.json",
  "title": "ProviderLocation",
  "description": "Operator-facing ManagedResource under Provider scope (FEATURE-0014). Sole location kind/term; parent Provider is metadata.scopeRef only. Optional descriptive geo; no alias, parent, connectivity, capacity, capability, adapter, or provider-native fields.",
  "type": "object",
  "x-sovrunn-profile": "ManagedResource",
  "x-sovrunn-boundary": "operator-facing",
  "x-sovrunn-allowed-scopes": ["Provider"],
  "x-sovrunn-stability": "alpha",
  "properties": {
    "apiVersion": {
      "type": "string",
      "enum": ["fabric.sovrunn.io/v1alpha1"],
      "description": "Contract group and maturity version for ProviderLocation.",
      "x-sovrunn-field-policy": {
        "classification": "Public",
        "authorizedWriter": "system",
        "authorizedReaders": ["operator", "internal", "governance"],
        "mutability": "immutable",
        "retention": "standard",
        "redaction": "none",
        "residency": "any",
        "auditRequired": true
      }
    },
    "kind": {
      "type": "string",
      "enum": ["ProviderLocation"],
      "description": "Singular PascalCase resource kind. Collection: provider-locations.",
      "x-sovrunn-field-policy": {
        "classification": "Public",
        "authorizedWriter": "system",
        "authorizedReaders": ["operator", "internal", "governance"],
        "mutability": "immutable",
        "retention": "standard",
        "redaction": "none",
        "residency": "any",
        "auditRequired": true
      }
    },
    "metadata": {
      "$ref": "_common/object-meta.json",
      "description": "Common ObjectMeta. The offline semantic validator requires an immutable Provider scopeRef identifying the containing Provider. No separate topology parent field.",
      "x-sovrunn-field-policy": {
        "classification": "Operator-confidential",
        "authorizedWriter": "creator",
        "authorizedReaders": ["operator", "internal", "governance"],
        "mutability": "mutable",
        "retention": "standard",
        "redaction": "none",
        "residency": "any",
        "auditRequired": true
      }
    },
    "spec": {
      "type": "object",
      "description": "Desired state for ProviderLocation. Optional descriptive geo only; no parent, alias location term, connectivity, capacity, or native field.",
      "properties": {
        "geo": {
          "type": "object",
        "description": "Optional descriptive declared topology (ISO 3166-1/3166-2 format only). Not residency proof, compliance evidence, authoritative assignment, or placement input. The schema checks each field independently; the offline semantic validator enforces country-prefix agreement. No ISO membership lookup.",
          "properties": {
            "countryCode": {
              "type": "string",
              "minLength": 2,
              "maxLength": 2,
              "pattern": "^[A-Z]{2}$",
              "description": "ISO 3166-1 alpha-2 country code: exactly two uppercase ASCII letters.",
              "x-sovrunn-field-policy": {
                "classification": "Operator-confidential",
                "authorizedWriter": "spec-owner",
                "authorizedReaders": ["operator", "internal", "governance"],
                "mutability": "mutable",
                "retention": "standard",
                "redaction": "none",
                "residency": "any",
                "auditRequired": false
              }
            },
            "subdivisionCode": {
              "type": "string",
              "minLength": 4,
              "maxLength": 6,
              "pattern": "^[A-Z]{2}-[A-Z0-9]{1,3}$",
            "description": "Optional ISO 3166-2 subdivision code (≤ 6 chars). The offline semantic validator requires its country prefix to equal countryCode; format only, no membership check.",
              "x-sovrunn-field-policy": {
                "classification": "Operator-confidential",
                "authorizedWriter": "spec-owner",
                "authorizedReaders": ["operator", "internal", "governance"],
                "mutability": "mutable",
                "retention": "standard",
                "redaction": "none",
                "residency": "any",
                "auditRequired": false
              }
            }
          },
          "required": ["countryCode"],
          "additionalProperties": false,
          "x-sovrunn-field-policy": {
            "classification": "Operator-confidential",
            "authorizedWriter": "spec-owner",
            "authorizedReaders": ["operator", "internal", "governance"],
            "mutability": "mutable",
            "retention": "standard",
            "redaction": "none",
            "residency": "any",
            "auditRequired": false
          }
        }
      },
      "additionalProperties": false,
      "x-sovrunn-field-policy": {
        "classification": "Operator-confidential",
        "authorizedWriter": "spec-owner",
        "authorizedReaders": ["operator", "internal", "governance"],
        "mutability": "mutable",
        "retention": "standard",
        "redaction": "none",
        "residency": "any",
        "auditRequired": true
      }
    },
    "status": {
      "type": "object",
      "description": "System-owned observed state for ProviderLocation. Current-fact conditions only; no phase vocabulary.",
      "properties": {
        "observedGeneration": {
          "type": "integer",
          "minimum": 0,
          "description": "Desired-state generation last observed by the status owner.",
          "x-sovrunn-field-policy": {
            "classification": "Internal",
            "authorizedWriter": "status-owner",
            "authorizedReaders": ["operator", "internal", "governance"],
            "mutability": "system-only",
            "retention": "standard",
            "redaction": "none",
            "residency": "any",
            "auditRequired": false
          }
        },
        "conditions": {
          "type": "array",
          "items": {
            "$ref": "_common/condition.json"
          },
          "description": "Current-fact conditions (Valid, TopologyComplete); not event history.",
          "x-sovrunn-field-policy": {
            "classification": "Operator-confidential",
            "authorizedWriter": "status-owner",
            "authorizedReaders": ["operator", "internal", "governance"],
            "mutability": "system-only",
            "retention": "standard",
            "redaction": "redact",
            "residency": "any",
            "auditRequired": true
          }
        }
      },
      "additionalProperties": false,
      "x-sovrunn-field-policy": {
        "classification": "Operator-confidential",
        "authorizedWriter": "status-owner",
        "authorizedReaders": ["operator", "internal", "governance"],
        "mutability": "system-only",
        "retention": "standard",
        "redaction": "none",
        "residency": "any",
        "auditRequired": true
      }
    }
  },
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "additionalProperties": false
}
