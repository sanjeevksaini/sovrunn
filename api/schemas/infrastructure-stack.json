          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9 ._+-]{0,99}$",
          "maxLength": 100,
          "description": "Optional bounded descriptive infrastructure-technology string (1\u2013100 chars). Not an enum, not identity, and not a reference key.",
